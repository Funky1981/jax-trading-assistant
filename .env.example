# =============================================================================
# JAX Trading Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed:
#   cp .env.example .env
#
# This file configures ALL services. Docker Compose automatically loads it.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# SECURITY: Use scripts/generate-credentials.ps1 to create secure passwords
POSTGRES_USER=jax
POSTGRES_PASSWORD=jax
POSTGRES_DB=jax
DATABASE_URL=postgresql://jax:jax@postgres:5432/jax
KNOWLEDGE_DATABASE_URL=postgresql://jax:jax@postgres:5432/jax_knowledge

# For local development outside Docker:
# DATABASE_URL=postgresql://jax:jax@localhost:5432/jax

# -----------------------------------------------------------------------------
# Redis Configuration (optional - for future distributed rate limiting)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379/0

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# SECURITY: Use scripts/generate-credentials.ps1 to generate a secure secret
# Use a long, random string (64+ characters recommended)
JWT_SECRET=change_this_to_a_secure_random_string_min_64_chars
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Market Data Provider
# -----------------------------------------------------------------------------
# Options: alpaca, polygon, ib (Interactive Brokers)
MARKET_DATA_PROVIDER=ib

# Alpaca (if using alpaca provider)
# ALPACA_API_KEY=your_key_here
# ALPACA_API_SECRET=your_secret_here

# Polygon (if using polygon provider)
# POLYGON_API_KEY=your_key_here
# Optional: override base URL or auth mode (bearer or query)
# POLYGON_BASE_URL=https://api.polygon.io
# POLYGON_AUTH_MODE=bearer

# Massive (Polygon rebrand) REST API
# MASSIVE_API_KEY=your_key_here
# MASSIVE_BASE_URL=https://api.massive.com

# Interactive Brokers Gateway (if using ib provider)
# No API key needed - uses socket connection
IB_GATEWAY_HOST=host.docker.internal
IB_GATEWAY_PORT=4002
IB_CLIENT_ID=1

# -----------------------------------------------------------------------------
# Services
# -----------------------------------------------------------------------------
# Runtime policy (required for non-local deployments)
JAX_RUNTIME_MODE=paper
JAX_REQUIRE_EXPLICIT_RUNTIME_MODE=true
# Live trading is blocked unless both runtime mode is live and this is true.
ALLOW_LIVE_TRADING=false
# Paper-safety projection values. Leave unset only when an environment should
# surface safety as Unknown; do not substitute frontend or backend defaults.
BROKER_EXECUTION_ALLOWED=false
MAX_LEVERAGE=1

# jax-api
JAX_API_PORT=8081
JAX_ORCHESTRATOR_URL=http://jax-research:8091

# research memory
JAX_RESEARCH_PORT=8091
EMBEDDING_PROVIDER=local

# jax-ingest (for scheduled jobs)
JAX_INGEST_INTERVAL=60
JAX_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA

# Trade executor risk gates
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS=0

# -----------------------------------------------------------------------------
# Mobile approval notifications (optional Telegram delivery)
# -----------------------------------------------------------------------------
# Leave blank to keep mobile delivery disabled. When set, jax-trader dispatches
# queued approval notifications from notification_outbox to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional but required for inline Approve/Reject/Snooze buttons to call Jax.
# Must be a public HTTPS URL that reaches:
#   /api/v1/mobile/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Agent0 (AI)
# -----------------------------------------------------------------------------
# Use Ollama (local) by default. Set model to one you have pulled.
AGENT0_LLM_PROVIDER=ollama
AGENT0_OLLAMA_HOST=http://host.docker.internal:11434
AGENT0_OLLAMA_MODEL=phi3:3.8b
AGENT0_MEMORY_BANK=trades
# Optional: OpenAI (paid)
# AGENT0_OPENAI_API_KEY=your_openai_key
# AGENT0_OPENAI_MODEL=gpt-4o-mini
# Optional: Anthropic (paid)
# AGENT0_ANTHROPIC_API_KEY=your_anthropic_key
# AGENT0_ANTHROPIC_MODEL=claude-3-haiku-20240307

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8081
VITE_MEMORY_API_URL=http://localhost:8091

# -----------------------------------------------------------------------------
# Jax Assistant (LLM) — optional, falls back to advisory replies if not set
# -----------------------------------------------------------------------------
# Supports explicit embedding provider selection for cmd/research memory.
# EMBEDDING_PROVIDER=local                        # default; zero paid API usage
# EMBEDDING_PROVIDER=openai                       # requires OPENAI_API_KEY
# OPENAI_API_KEY=sk-...                           # required only when EMBEDDING_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com          # default for openai provider
# EMBEDDING_MODEL=text-embedding-3-small          # default for openai provider
# OPENAI_MODEL=gpt-4o-mini                        # default

# -----------------------------------------------------------------------------
# Read-only AI shadow benchmark (local Ollama; disabled until explicitly run)
# -----------------------------------------------------------------------------
JAX_AI_SHADOW_ENABLED=false
JAX_AI_PROVIDER=ollama
JAX_AI_MODEL=qwen3.5:9b
# Host-run default. Container-run default: http://host.docker.internal:11434
JAX_AI_BASE_URL=http://localhost:11434
JAX_AI_TIMEOUT_SECONDS=120
JAX_AI_TEMPERATURE=0
JAX_AI_SEED=20260803
JAX_AI_MAX_EVENTS=60

# -----------------------------------------------------------------------------
# Logging / Debug
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# Set to true for verbose output
DEBUG=false
